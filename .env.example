# ---------- Backend ----------
ENV=development                      # development | production | test
DATABASE_URL=postgresql+psycopg://bms:bms@localhost:5432/bookmyshow
JWT_SECRET=change-me-to-a-long-random-string   # python -c "import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Google OAuth: create a "Web application" OAuth client at https://console.cloud.google.com/apis/credentials
# and add http://localhost:5173 to its Authorised JavaScript origins. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
# Needed for Google Calendar sync (authorization-code flow). Never commit a real value.
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to FRONTEND_URL + /api/v1/calendar/callback; must be in the OAuth client's authorised redirect URIs.
GOOGLE_REDIRECT_URI=

# Razorpay: use TEST mode keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set to the secret you configure on the webhook (dashboard -> Webhooks -> events: payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# Booking rules
SEAT_LOCK_MINUTES=8
PAYMENT_WINDOW_MINUTES=10
MAX_SEATS_PER_BOOKING=10
CONVENIENCE_FEE_PCT=3.0
GST_PCT=18.0
CANCELLATION_CUTOFF_HOURS=2

# Optional SMTP for confirmation emails (otherwise emails are logged and shown as in-app notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=tickets@example.com

# Seeded admin account (change in production!)
ADMIN_EMAIL=admin@bookmyshow.example.com
ADMIN_PASSWORD=Admin@12345

# ---------- Frontend (frontend/.env) ----------
# VITE_API_URL=http://localhost:8000/api/v1
